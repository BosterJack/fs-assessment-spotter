DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: enables truck-specific routing. Free ORS alternatives limited to 100 km.
ORS_API_KEY=
# Default OSRM profile is standard road routing, not legal truck routing.
OSRM_URL=https://router.project-osrm.org
WEATHER_URL=https://api.open-meteo.com/v1/forecast
SECURE_SSL_REDIRECT=false
# Docker Compose: frontend exposed locally on this port.
FRONTEND_PORT=8080
